(PCB "partial"
  (parser (host_cad "EasyEDA Pro"))
  (resolution mil 1000)
  (structure
    (layer TopLayer (type signal))
    (layer BottomLayer (type signal))
    (boundary (path pcb 0 0 0 120 0 120 120 0 120 0 0))
    (via via0) (rule (width 4) (clear 4)))
  (placement (component u1 (place u1 0 0 front 0)))
  (library
    (image u1 (pin top 1 20 20) (pin top 2 100 20) (pin unknown 3 20 100) (pin unknown 4 100 100))
    (padstack top (shape (circle TopLayer 8)))
    (padstack unknown (shape (circle Mechanical 8)))
    (padstack via0 (shape (circle TopLayer 20)) (shape (circle BottomLayer 20))))
  (network
    (net GOOD (pins u1-1 u1-2))
    (net BAD (pins u1-3 u1-4))
    (class GOOD 'GOOD' (circuit (use_via via0)) (rule (width 4) (clearance 4)))
    (class BAD 'BAD' (circuit (use_via via0)) (rule (width 4) (clearance 4)))))
