(PCB "three-pin"
  (parser (host_cad "EasyEDA Pro") (host_version "3.2.0"))
  (resolution mil 1000)
  (structure
    (layer TopLayer (type signal))
    (layer BottomLayer (type signal))
    (boundary (path pcb 0 0 0 120 0 120 120 0 120 0 0))
    (via via0)
    (rule (width 4) (clear 4)))
  (placement (component u1 (place u1 0 0 front 0)))
  (library
    (image u1
      (pin smd 1 20 20)
      (pin smd 2 100 20)
      (pin smd 3 100 100))
    (padstack smd (shape (circle TopLayer 8)))
    (padstack via0
      (shape (circle TopLayer 16))
      (shape (circle BottomLayer 16))))
  (network
    (net GND (pins u1-1 u1-2 u1-3))
    (class GND 'GND' (circuit (use_via via0)) (rule (width 4) (clearance 4)))))
